# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Local LLM (Ollama) — the default, free, offline path. Phase 1. ---
# The internal disk has very little room, so weights live on the external drive.
OLLAMA_MODELS=/Volumes/DEVHAN/ollama-models
OLLAMA_HOST=http://127.0.0.1:11434
ROLEX_MODEL=qwen2.5:3b

# --- Google Gemini — free-tier fallback. Phase 5. ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Behaviour ---
# local | gemini
ROLEX_PROVIDER=local
ROLEX_LOG_LEVEL=WARNING
# How much the model varies its answers. Low, because deciding whether to use
# a tool should come out the same way every time. Raise it for chattier replies.
ROLEX_TEMPERATURE=0.2

# Whether rolex may run tools that delete, overwrite or send something.
# Off by default on purpose.
ROLEX_ALLOW_DESTRUCTIVE=false
