# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Local LLM (Ollama) — the default, free, offline path. Phase 1. ---
# The internal disk has very little room, so weights live on the external drive.
OLLAMA_MODELS=/Volumes/DEVHAN/ollama-models
OLLAMA_HOST=http://127.0.0.1:11434
ROLEX_MODEL=qwen2.5:3b

# --- Google Gemini — optional cloud provider and fallback. Phase 7. ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Behaviour ---
# local | gemini
ROLEX_PROVIDER=local
ROLEX_LOG_LEVEL=WARNING
# How much the model varies its answers. Low, because deciding whether to use
# a tool should come out the same way every time. Raise it for chattier replies.
ROLEX_TEMPERATURE=0.2

# Whether rolex may run tools that delete, overwrite or send something.
# Off by default on purpose.
ROLEX_ALLOW_DESTRUCTIVE=false

# --- Voice (Phase 4) ---
# Speech-to-text weights. On the external drive; `make whisper-model` fetches them.
ROLEX_WHISPER_MODEL=/Volumes/DEVHAN/whisper-models/ggml-base.en.bin

# Microphone, as ffmpeg's avfoundation index. Empty = system default.
# List them: ffmpeg -f avfoundation -list_devices true -i ""
ROLEX_AUDIO_DEVICE=

# How long to record a command, and how much quiet ends a sentence.
ROLEX_LISTEN_SECONDS=8
ROLEX_SILENCE_SECONDS=1.2

# Whether rolex answers out loud, and in which macOS voice (say -v '?').
ROLEX_SPEAK=true
ROLEX_VOICE=

# Keep the microphone open instead of recording in fixed clips. Clips lose
# whatever falls across a boundary, which cut words off the end of commands.
ROLEX_STREAM=true

# Threads whisper may use. 0 = one fewer than the machine has.
ROLEX_TRANSCRIBE_THREADS=0

# Microphone for continuous listening, as whisper-stream's SDL capture index.
# Separate from ROLEX_AUDIO_DEVICE: the two number their devices differently.
ROLEX_STREAM_DEVICE=

# Model used for drafting replies to clients. Empty = same as ROLEX_MODEL.
# Worth making this a larger one: a 3B model invented a price for a client
# where a 7B asked for it instead.
ROLEX_REPLY_MODEL=

# Language for drafted replies: same (follow the conversation), english, marathi.
ROLEX_REPLY_LANGUAGE=same

# Gemini uses this cloud model for direct requests and fallback.
ROLEX_GEMINI_MODEL=gemini-2.5-flash
# Explicit opt-in: if local inference fails, conversation and tool results go to Google.
ROLEX_GEMINI_FALLBACK=false
